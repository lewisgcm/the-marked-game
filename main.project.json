{
	"name": "main-game",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					}
				}
			},
			"Shared": {
				"$path": "out/shared"
			},
			"Assets": {
				"$className": "Folder",
				"LightCone": {
					"$path": "assets/rojo/light_cone.model.json"
				}
			}
		},
		"ServerStorage": {
			"$className": "ServerStorage",
			"MapTiles": {
				"$path": "build/tiles/models"
			},
			"MapKit": {
				"$path": "build/tiles/kit"
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Main": {
				"$path": "out/main/server"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Main": {
					"$path": "out/main/client"
				}
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"FilteringEnabled": true,
				"StreamingEnabled": false
			}
		},
		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		},
		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
