{
  "name": "marked",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "rbxtsc",
    "watch": "npm run -s tiles:watch & rbxtsc -w",
    "serve": "npm run -s tiles:build && rojo serve",
    "serve:lobby": "rojo serve lobby.project.json",
    "serve:main": "npm run -s tiles:build && rojo serve main.project.json",
    "serve:tiles": "npm run tiles && rojo serve tiles.project.json",
    "build:lobby": "rojo build lobby.project.json -o build/lobby.rbxlx",
    "build:main": "npm run -s tiles:build && rojo build main.project.json -o build/main.rbxlx",
    "build:dev": "npm run -s tiles:build && rojo build default.project.json -o build/dev.rbxlx",
    "tiles:build": "tsc -p tools/tiles && node tools/tiles/build.ts",
    "tiles:watch": "node --watch --watch-preserve-output tools/tiles/build.ts --gallery",
    "tiles": "npm run -s tiles:build && lune run tools/tiles/gallery",
    "models": "bash tools/blender/build.sh",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "rbxtsc && npm run -s tiles && lune run tests/run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rbxts/compiler-types": "^3.0.0-types.0",
    "@rbxts/types": "^1.0.962",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-roblox-ts": "^1.4.1",
    "prettier": "^3.10.1",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@rbxts/react": "^17.3.13-ts.1",
    "@rbxts/react-roblox": "^17.3.13-ts.1",
    "@rbxts/services": "^1.6.0",
    "@rbxts/zone-plus": "^3.2.0"
  }
}
