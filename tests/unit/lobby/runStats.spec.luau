-- Best run and total nights (src/shared/lobby/runStats.ts).
return function(t)
	local R = require("../../../out/shared/lobby/runStats")

	t.describe("addRun", function()
		t.it("a first run is both the best and the total", function()
			local s = R.addRun(nil, 4)
			t.expect(s.best).toBe(4)
			t.expect(s.total).toBe(4)
		end)
		t.it("a shorter run adds to the total but not the best", function()
			local s = R.addRun({ best = 7, total = 12 }, 3)
			t.expect(s.best).toBe(7)
			t.expect(s.total).toBe(15)
		end)
		t.it("a longer run is the new best", function()
			local s = R.addRun({ best = 7, total = 12 }, 9)
			t.expect(s.best).toBe(9)
			t.expect(s.total).toBe(21)
		end)
		t.it("a run of no nights changes nothing", function()
			local s = R.addRun({ best = 2, total = 5 }, 0)
			t.expect(s.best).toBe(2)
			t.expect(s.total).toBe(5)
		end)
		t.it("broken saves and nonsense runs count as nothing", function()
			local s = R.addRun({ best = "lots", total = -3 }, -2)
			t.expect(s.best).toBe(0)
			t.expect(s.total).toBe(0)
			t.expect(R.addRun(42, 0 / 0).total).toBe(0)
			t.expect(R.addRun({ best = 2.7, total = 5 }, 1.9).best).toBe(2)
		end)
	end)
end
