-- Sanity and panic rules (src/shared/sanity.ts).
return function(t)
	local sanity = require("../../out/shared/sanity")
	local rates = { drainAlone = 0.8, recoverOne = 0.5, recoverBoth = 1.5, ghostChill = 1.2 }
	local function rate(lit, company, ghostNear)
		return sanity.sanityRate({ lit = lit, company = company, ghostNear = ghostNear }, rates)
	end

	t.describe("sanityRate", function()
		t.it("drains when alone in the dark", function()
			t.expect(rate(false, false, false)).toBeCloseTo(-0.8)
		end)
		t.it("recovers slowly near a lamp", function()
			t.expect(rate(true, false, false)).toBeCloseTo(0.5)
		end)
		t.it("recovers slowly with a teammate", function()
			t.expect(rate(false, true, false)).toBeCloseTo(0.5)
		end)
		t.it("recovers faster with both", function()
			t.expect(rate(true, true, false)).toBeCloseTo(1.5)
		end)
		t.it("the ghost nearby drains extra, alone", function()
			t.expect(rate(false, false, true)).toBeCloseTo(-2.0)
		end)
		t.it("the ghost nearby eats into recovery", function()
			t.expect(rate(true, true, true)).toBeCloseTo(0.3)
		end)
	end)

	t.describe("stepSanity", function()
		t.it("applies rate x time", function()
			t.expect(sanity.stepSanity(50, -0.8, 10)).toBeCloseTo(42)
		end)
		t.it("never goes below 0", function()
			t.expect(sanity.stepSanity(1, -5, 10)).toBe(0)
		end)
		t.it("never goes above the max", function()
			t.expect(sanity.stepSanity(99, 5, 10)).toBe(sanity.SANITY_MAX)
		end)
		t.it("a lone hunter in the dark empties in about two minutes", function()
			local value, seconds = sanity.SANITY_MAX, 0
			while value > 0 and seconds < 1000 do
				value = sanity.stepSanity(value, rate(false, false, false), 0.25)
				seconds += 0.25
			end
			t.expect(seconds).toBeBetween(124, 126)
		end)
	end)

	t.describe("nextPanicState (start at 0, recover at 20)", function()
		local function next(panicking, value)
			return sanity.nextPanicState(panicking, value, 0, 20)
		end
		t.it("calm above 0 stays calm", function()
			t.expect(next(false, 0.5)).toBe(false)
		end)
		t.it("panics on reaching 0", function()
			t.expect(next(false, 0)).toBe(true)
		end)
		t.it("stays panicking while recovering below 20", function()
			t.expect(next(true, 10)).toBe(true)
			t.expect(next(true, 19.9)).toBe(true)
		end)
		t.it("calms down at 20", function()
			t.expect(next(true, 20)).toBe(false)
		end)
		t.it("a calm hunter at 10 doesn't panic (no flicker in the gap)", function()
			t.expect(next(false, 10)).toBe(false)
		end)
		t.it("respects a configured start threshold", function()
			t.expect(sanity.nextPanicState(false, 5, 5, 20)).toBe(true)
		end)
	end)
end
