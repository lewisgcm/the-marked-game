-- Slingshot aim validation and ammo (src/shared/ranged.ts).
return function(t)
	local ranged = require("../../out/shared/ranged")

	t.describe("normaliseAim", function()
		t.it("normalises a direction", function()
			local aim = ranged.normaliseAim(0, 0, -5)
			t.expect(aim[3]).toBe(-1)
			t.expect(aim[1]).toBe(0)
		end)
		t.it("rejects a zero vector", function()
			t.expect(ranged.normaliseAim(0, 0, 0)).toBe(nil)
		end)
		t.it("rejects NaN", function()
			t.expect(ranged.normaliseAim(0 / 0, 1, 0)).toBe(nil)
		end)
		t.it("rejects infinity", function()
			t.expect(ranged.normaliseAim(math.huge, 0, 0)).toBe(nil)
		end)
	end)

	t.describe("cooldownReady", function()
		t.it("the first shot is always ready", function()
			t.expect(ranged.cooldownReady(10, nil, 0.6)).toBe(true)
		end)
		t.it("waits out the cooldown", function()
			t.expect(ranged.cooldownReady(10.5, 10, 0.6)).toBe(false)
			t.expect(ranged.cooldownReady(10.65, 10, 0.6)).toBe(true)
		end)
	end)
end
