-- The slot inventory (src/shared/items/inventory.ts).
return function(t)
	local I = require("../../../out/shared/items/inventory")

	t.describe("addItem", function()
		t.it("fills a slot, then spills into the next", function()
			local inv = I.emptyInventory(5)
			t.expect(I.addItem(inv, "Planks", 7)).toBe(7)
			t.expect(#inv.stacks).toBe(2)
			t.expect(inv.stacks[1].count).toBe(5)
			t.expect(inv.stacks[2].count).toBe(2)
		end)
		t.it("tops up an existing stack first", function()
			local inv = I.emptyInventory(5)
			I.addItem(inv, "Nails", 5)
			I.addItem(inv, "Nails", 5)
			t.expect(#inv.stacks).toBe(1)
			t.expect(inv.stacks[1].count).toBe(10)
		end)
		t.it("only adds what fits", function()
			local inv = I.emptyInventory(1)
			I.addItem(inv, "Planks", 3)
			t.expect(I.addItem(inv, "Planks", 9)).toBe(2)
			t.expect(I.addItem(inv, "Nails", 1)).toBe(0)
			t.expect(#inv.stacks).toBe(1)
		end)
		t.it("ignores negative counts", function()
			local inv = I.emptyInventory(2)
			t.expect(I.addItem(inv, "Food", -3)).toBe(0)
			t.expect(#inv.stacks).toBe(0)
		end)
	end)

	t.describe("fuel cans", function()
		t.it("take a slot each", function()
			local inv = I.emptyInventory(3)
			t.expect(I.addItem(inv, "Fuel", 2)).toBe(2)
			t.expect(#inv.stacks).toBe(2)
			t.expect(I.roomFor(inv, "Fuel")).toBe(1)
		end)
	end)

	t.describe("roomFor and countOf", function()
		t.it("counts gaps and empty slots", function()
			local inv = I.emptyInventory(2)
			I.addItem(inv, "Planks", 3)
			t.expect(I.roomFor(inv, "Planks")).toBe(7)
			t.expect(I.roomFor(inv, "Nails")).toBe(20)
			t.expect(I.countOf(inv, "Planks")).toBe(3)
		end)
	end)

	t.describe("removeItem", function()
		t.it("takes across stacks and frees emptied slots", function()
			local inv = I.emptyInventory(5)
			I.addItem(inv, "Planks", 7)
			t.expect(I.removeItem(inv, "Planks", 3)).toBe(true)
			t.expect(I.countOf(inv, "Planks")).toBe(4)
			t.expect(#inv.stacks).toBe(1)
		end)
		t.it("is all or nothing", function()
			local inv = I.emptyInventory(5)
			I.addItem(inv, "Nails", 2)
			t.expect(I.removeItem(inv, "Nails", 3)).toBe(false)
			t.expect(I.countOf(inv, "Nails")).toBe(2)
			t.expect(I.removeItem(inv, "Nails", 0)).toBe(false)
		end)
		t.it("leaves other items alone", function()
			local inv = I.emptyInventory(5)
			I.addItem(inv, "Stones", 4)
			I.addItem(inv, "Nails", 4)
			I.removeItem(inv, "Stones", 4)
			t.expect(I.countOf(inv, "Nails")).toBe(4)
			t.expect(I.countOf(inv, "Stones")).toBe(0)
		end)
	end)

	t.describe("isUsable", function()
		t.it("medkits and shutters only", function()
			t.expect(I.isUsable("Medkit")).toBe(true)
			t.expect(I.isUsable("Shutter")).toBe(true)
			t.expect(I.isUsable("Fuel")).toBe(false)
			t.expect(I.isUsable("Scrap")).toBe(false)
		end)
	end)

	t.describe("takeStack and parseSlot", function()
		t.it("empties one slot", function()
			local inv = I.emptyInventory(5)
			I.addItem(inv, "Stones", 4)
			I.addItem(inv, "Food", 1)
			t.expect(I.takeStack(inv, 0).item).toBe("Stones")
			t.expect(#inv.stacks).toBe(1)
			t.expect(inv.stacks[1].item).toBe("Food")
		end)
		t.it("accepts only whole numbers naming a filled slot", function()
			local inv = I.emptyInventory(5)
			I.addItem(inv, "Stones", 4)
			I.addItem(inv, "Food", 1)
			t.expect(I.parseSlot(0, inv)).toBe(0)
			t.expect(I.parseSlot(1, inv)).toBe(1)
			t.expect(I.parseSlot(2, inv)).toBe(nil)
			t.expect(I.parseSlot(-1, inv)).toBe(nil)
			t.expect(I.parseSlot(0.5, inv)).toBe(nil)
			t.expect(I.parseSlot(0 / 0, inv)).toBe(nil)
			t.expect(I.parseSlot("0", inv)).toBe(nil)
		end)
	end)
end
