-- "+3 Nails" (src/shared/items/gains.ts).
return function(t)
	local G = require("../../../out/shared/items/gains")

	local function stack(item, count)
		return { item = item, count = count }
	end

	t.describe("gainedItems", function()
		t.it("new things, and more of what you had", function()
			local gains = G.gainedItems({ stack("Nails", 2) }, { stack("Nails", 5), stack("Food", 1) })
			t.expect(#gains).toBe(2)
			t.expect(gains[1].item).toBe("Nails")
			t.expect(gains[1].count).toBe(3)
			t.expect(gains[2].item).toBe("Food")
			t.expect(gains[2].count).toBe(1)
		end)
		t.it("spilling into another stack is one gain", function()
			local gains = G.gainedItems({ stack("Planks", 4) }, { stack("Planks", 5), stack("Planks", 2) })
			t.expect(#gains).toBe(1)
			t.expect(gains[1].count).toBe(3)
		end)
		t.it("rearranging, losing or using things isn't a gain", function()
			t.expect(#G.gainedItems({ stack("Food", 1), stack("Nails", 2) }, { stack("Nails", 2), stack("Food", 1) })).toBe(0)
			t.expect(#G.gainedItems({ stack("Nails", 5) }, { stack("Nails", 4) })).toBe(0)
			t.expect(#G.gainedItems({ stack("Nails", 5) }, {})).toBe(0)
		end)
		t.it("swapping one thing for another shows only the new one", function()
			local gains = G.gainedItems({ stack("Food", 3) }, { stack("Scrap", 1) })
			t.expect(#gains).toBe(1)
			t.expect(gains[1].item).toBe("Scrap")
		end)
	end)

	t.describe("addGains", function()
		t.it("adds to the line that's showing, and keeps it up longer", function()
			local lines = G.addGains({}, { stack("Nails", 3) }, 0, 2)
			lines = G.addGains(lines, { stack("Nails", 4) }, 1, 2)
			t.expect(#lines).toBe(1)
			t.expect(lines[1].count).toBe(7)
			t.expect(lines[1].endsAt).toBe(3)
		end)
		t.it("starts again once the line has gone", function()
			local lines = G.addGains({}, { stack("Nails", 3) }, 0, 2)
			lines = G.addGains(lines, { stack("Nails", 4) }, 2, 2)
			t.expect(#lines).toBe(1)
			t.expect(lines[1].count).toBe(4)
		end)
		t.it("different things get their own lines", function()
			local lines = G.addGains({}, { stack("Nails", 3) }, 0, 2)
			lines = G.addGains(lines, { stack("Coins", 5) }, 1, 2)
			t.expect(#lines).toBe(2)
			t.expect(lines[2].item).toBe("Coins")
		end)
		t.it("doesn't change the old lines", function()
			local old = G.addGains({}, { stack("Nails", 3) }, 0, 2)
			G.addGains(old, { stack("Nails", 4) }, 1, 2)
			t.expect(old[1].count).toBe(3)
		end)
	end)

	t.describe("liveGains", function()
		t.it("drops lines whose time is up", function()
			local lines = G.addGains({}, { stack("Nails", 3) }, 0, 2)
			t.expect(#G.liveGains(lines, 1.9)).toBe(1)
			t.expect(#G.liveGains(lines, 2)).toBe(0)
		end)
	end)
end
