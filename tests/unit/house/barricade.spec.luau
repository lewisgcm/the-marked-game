-- Barricade rules (src/shared/house/barricade.ts).
return function(t)
	local b = require("../../../out/shared/house/barricade")

	local function plank(health, reinforced)
		return { health = health, max = health, reinforced = reinforced == true }
	end
	local function planksOf(...)
		local planks = {}
		for i, health in { ... } do
			planks[i] = plank(health)
		end
		return planks
	end
	local function withPlanks(...)
		return { planks = planksOf(...) }
	end

	t.describe("adding and removing planks", function()
		t.it("adds planks up to the slot count", function()
			local bar = b.emptyBarricade()
			t.expect(b.addPlank(bar, 3, plank(100))).toBe(true)
			t.expect(b.addPlank(bar, 3, plank(100))).toBe(true)
			t.expect(b.addPlank(bar, 3, plank(100))).toBe(true)
			t.expect(b.addPlank(bar, 3, plank(100))).toBe(false)
			t.expect(#bar.planks).toBe(3)
		end)
		t.it("won't add a plank with no health", function()
			local bar = b.emptyBarricade()
			t.expect(b.addPlank(bar, 3, plank(0))).toBe(false)
			t.expect(#bar.planks).toBe(0)
		end)
		t.it("each plank stays what it was nailed as", function()
			local bar = b.emptyBarricade()
			b.addPlank(bar, 3, plank(100))
			b.addPlank(bar, 3, plank(150, true))
			t.expect(bar.planks[1].reinforced).toBe(false)
			t.expect(bar.planks[2].reinforced).toBe(true)
			b.damageBarricade(bar, 30, false)
			t.expect(bar.planks[2].reinforced).toBe(true)
			b.removePlank(bar)
			t.expect(#bar.planks).toBe(1)
			t.expect(bar.planks[1].reinforced).toBe(false)
		end)
		t.it("an opening is blocked while any plank is up", function()
			local bar = b.emptyBarricade()
			t.expect(b.isBlocked(bar)).toBe(false)
			b.addPlank(bar, 3, plank(100))
			t.expect(b.isBlocked(bar)).toBe(true)
			t.expect(b.removePlank(bar)).toBe(true)
			t.expect(b.isBlocked(bar)).toBe(false)
			t.expect(b.removePlank(bar)).toBe(false)
		end)
	end)

	t.describe("newPlank", function()
		local function new(overrides)
			local c = {
				base = 100,
				firstNight = 1,
				reinforced = false,
				reinforcedBy = 1.5,
				index = 0,
				normalSlots = 3,
				doorBar = 2,
			}
			for k, v in overrides do
				c[k] = v
			end
			return b.newPlank(c)
		end
		t.it("plain planks get the base", function()
			t.expect(new({}).health).toBe(100)
			t.expect(new({ index = 2 }).health).toBe(100)
			t.expect(new({}).reinforced).toBe(false)
		end)
		t.it("reinforced ones are sturdier, and say so", function()
			t.expect(new({ reinforced = true }).health).toBe(150)
			t.expect(new({ reinforced = true }).reinforced).toBe(true)
		end)
		t.it("only a door bar's extra slot is sturdier", function()
			t.expect(new({ index = 3 }).health).toBe(200)
			t.expect(new({ index = 3 }).reinforced).toBe(false)
		end)
		t.it("bonuses multiply", function()
			t.expect(new({ firstNight = 2, reinforced = true }).health).toBe(300)
			t.expect(new({ firstNight = 2, reinforced = true, index = 3 }).health).toBe(600)
		end)
	end)

	t.describe("damageBarricade", function()
		t.it("wears down the outermost plank first", function()
			local bar = withPlanks(100, 100)
			local result = b.damageBarricade(bar, 30, false)
			t.expect(result.broken).toBe(0)
			t.expect(bar.planks[1].health).toBe(100)
			t.expect(bar.planks[2].health).toBe(70)
		end)
		t.it("a plank at 0 falls off; the last one breaches", function()
			local bar = withPlanks(100, 20)
			local first = b.damageBarricade(bar, 20, false)
			t.expect(first.broken).toBe(1)
			t.expect(first.breached).toBe(false)
			t.expect(#bar.planks).toBe(1)
			local second = b.damageBarricade(bar, 100, false)
			t.expect(second.breached).toBe(true)
			t.expect(first.opened).toBe(false)
			t.expect(second.opened).toBe(true)
			t.expect(#bar.planks).toBe(0)
		end)
		t.it("one hit breaks at most one plank", function()
			local bar = withPlanks(100, 100, 10)
			local result = b.damageBarricade(bar, 500, false)
			t.expect(result.broken).toBe(1)
			t.expect(#bar.planks).toBe(2)
			t.expect(bar.planks[2].health).toBe(100)
		end)
		t.it("hitting an open gap does nothing, and says it's breached", function()
			local result = b.damageBarricade(b.emptyBarricade(), 50, false)
			t.expect(result.broken).toBe(0)
			t.expect(result.breached).toBe(true)
			t.expect(result.opened).toBe(false)
		end)
	end)

	t.describe("a shutter", function()
		local function shuttered(...)
			return { planks = planksOf(...), shutter = 50 }
		end
		t.it("is fitted once", function()
			local bar = b.emptyBarricade()
			t.expect(b.addShutter(bar, 0)).toBe(false)
			t.expect(b.addShutter(bar, 300)).toBe(true)
			t.expect(b.addShutter(bar, 999)).toBe(false)
			t.expect(bar.shutter).toBe(300)
		end)
		t.it("blocks the opening without planks", function()
			t.expect(b.isBlocked(shuttered())).toBe(true)
		end)
		t.it("is behind the planks, even for what breaks it", function()
			local bar = shuttered(10)
			local result = b.damageBarricade(bar, 500, true)
			t.expect(result.broken).toBe(1)
			t.expect(result.breached).toBe(false)
			t.expect(result.opened).toBe(false)
			t.expect(bar.shutter).toBe(50)
		end)
		t.it("can't be hurt by the rest", function()
			local bar = shuttered()
			local result = b.damageBarricade(bar, 500, false)
			t.expect(bar.shutter).toBe(50)
			t.expect(result.breached).toBe(false)
		end)
		t.it("breaks at 0 for what can break it", function()
			local bar = shuttered()
			t.expect(b.damageBarricade(bar, 20, true).opened).toBe(false)
			t.expect(bar.shutter).toBe(30)
			local result = b.damageBarricade(bar, 30, true)
			t.expect(bar.shutter).toBe(nil)
			t.expect(result.opened).toBe(true)
			t.expect(result.breached).toBe(true)
			t.expect(result.broken).toBe(0)
		end)
		t.it("damage below 0 mends nothing", function()
			local bar = shuttered()
			b.damageBarricade(bar, -5, true)
			t.expect(bar.shutter).toBe(50)
			local planks = withPlanks(10)
			b.damageBarricade(planks, -5, true)
			t.expect(planks.planks[1].health).toBe(10)
		end)
	end)

	t.describe("isWorthAttacking", function()
		t.it("anything without a shutter", function()
			t.expect(b.isWorthAttacking(b.emptyBarricade(), false)).toBe(true)
			t.expect(b.isWorthAttacking(withPlanks(10), false)).toBe(true)
		end)
		t.it("a shutter only with planks over it, or for what breaks it", function()
			t.expect(b.isWorthAttacking({ planks = {}, shutter = 50 }, false)).toBe(false)
			t.expect(b.isWorthAttacking({ planks = planksOf(10), shutter = 50 }, false)).toBe(true)
			t.expect(b.isWorthAttacking({ planks = {}, shutter = 50 }, true)).toBe(true)
		end)
	end)

	t.describe("planksToTake", function()
		t.it("fills your arms", function()
			t.expect(b.planksToTake(2, 5, 30)).toBe(3)
		end)
		t.it("is limited by the pile", function()
			t.expect(b.planksToTake(0, 5, 2)).toBe(2)
		end)
		t.it("never negative", function()
			t.expect(b.planksToTake(5, 5, 30)).toBe(0)
			t.expect(b.planksToTake(0, 5, 0)).toBe(0)
		end)
	end)

	t.describe("doors", function()
		t.it("starts whole and shut: blocked, but nothing boarded", function()
			local door = b.newDoor(200)
			t.expect(b.isBlocked(door)).toBe(true)
			t.expect(b.isBoarded(door)).toBe(false)
			t.expect(b.isWorthAttacking(door, false)).toBe(true)
		end)
		t.it("opens and closes; open, it lets anyone in and takes no damage", function()
			local door = b.newDoor(200)
			t.expect(b.toggleDoor(door)).toBe(true)
			t.expect(b.isBlocked(door)).toBe(false)
			b.damageBarricade(door, 50, false)
			t.expect(door.door.health).toBe(200)
			b.toggleDoor(door)
			t.expect(b.isBlocked(door)).toBe(true)
		end)
		t.it("its boards take the hits first, then the door", function()
			local door = b.newDoor(100)
			b.addPlank(door, 3, plank(30))
			local first = b.damageBarricade(door, 40, false)
			t.expect(first.broken).toBe(1)
			t.expect(door.door.health).toBe(100)
			b.damageBarricade(door, 40, false)
			t.expect(door.door.health).toBe(60)
		end)
		t.it("breaks at 0: open, and no more boards until it's fixed", function()
			local door = b.newDoor(50)
			local result = b.damageBarricade(door, 60, false)
			t.expect(result.opened).toBe(true)
			t.expect(door.door.broken).toBe(true)
			t.expect(b.isBlocked(door)).toBe(false)
			t.expect(b.canAddPlank(door, 3)).toBe(false)
			t.expect(b.toggleDoor(door)).toBe(false)
		end)
		t.it("a fixed door is shut, whole again, and patched", function()
			local door = b.newDoor(50)
			t.expect(b.fixDoor(door, 120)).toBe(false) -- not broken yet
			b.damageBarricade(door, 60, false)
			t.expect(b.fixDoor(door, 120)).toBe(true)
			t.expect(door.door.health).toBe(120)
			t.expect(door.door.fixes).toBe(1)
			t.expect(b.isBlocked(door)).toBe(true)
			t.expect(b.canAddPlank(door, 3)).toBe(true)
		end)
	end)

	t.describe("glass", function()
		t.it("a new window is glazed, and blocked", function()
			local window = b.newWindow()
			t.expect(window.glass).toBe(true)
			t.expect(b.isBlocked(window)).toBe(true)
			t.expect(b.isBoarded(window)).toBe(false)
		end)
		t.it("the glass goes at the first hit, before any plank", function()
			local window = b.newWindow()
			b.addPlank(window, 3, plank(30))
			local result = b.damageBarricade(window, 500, false)
			t.expect(window.glass).toBe(false)
			t.expect(result.broken).toBe(0)
			t.expect(#window.planks).toBe(1)
			t.expect(result.opened).toBe(false)
		end)
		t.it("glass alone: the hit that smashes it opens the window", function()
			local result = b.damageBarricade(b.newWindow(), 5, false)
			t.expect(result.opened).toBe(true)
		end)
	end)

	t.describe("repair", function()
		t.it("new planks remember their health", function()
			local p = b.newPlank({ base = 100, firstNight = 2, reinforced = false, reinforcedBy = 1.5, index = 0, normalSlots = 3, doorBar = 2 })
			t.expect(p.max).toBe(200)
		end)
		t.it("tops up the outermost damaged plank first", function()
			local bar = { planks = { plank(100), plank(100) } }
			bar.planks[1].health = 40
			bar.planks[2].health = 70
			t.expect(b.wear(bar)).toBe(0.7)
			t.expect(b.repair(bar)).toBe(true)
			t.expect(bar.planks[2].health).toBe(100)
			t.expect(bar.planks[1].health).toBe(40)
			t.expect(b.wear(bar)).toBe(0.4)
		end)
		t.it("then a door, once its boards are sound", function()
			local door = b.newDoor(200)
			b.damageBarricade(door, 50, false)
			t.expect(b.wear(door)).toBe(0.75)
			t.expect(b.repair(door)).toBe(true)
			t.expect(door.door.health).toBe(200)
		end)
		t.it("nothing to repair: whole, or a broken door (that's fixed instead)", function()
			t.expect(b.wear({ planks = { plank(50) } })).toBe(nil)
			t.expect(b.repair({ planks = { plank(50) } })).toBe(false)
			local door = b.newDoor(30)
			b.damageBarricade(door, 40, false)
			t.expect(b.wear(door)).toBe(nil)
			t.expect(b.repair(door)).toBe(false)
		end)
	end)
end
