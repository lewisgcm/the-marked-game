-- Generator fuel (src/shared/house/fuel.ts).
return function(t)
	local F = require("../../../out/shared/house/fuel")
	local function near(a, b)
		return math.abs(a - b) < 1e-9
	end

	t.describe("burnFuel", function()
		t.it("one tank lasts exactly one night, however long nights are", function()
			t.expect(near(F.burnFuel(1, 150, 150, 1), 0)).toBe(true)
			t.expect(near(F.burnFuel(1, 60, 60, 1), 0)).toBe(true)
			t.expect(near(F.burnFuel(1, 75, 150, 1), 0.5)).toBe(true)
		end)
		t.it("a tune-up halves it", function()
			t.expect(near(F.burnFuel(1, 150, 150, 0.5), 0.5)).toBe(true)
		end)
		t.it("never below empty", function()
			t.expect(F.burnFuel(0.1, 150, 150, 1)).toBe(0)
		end)
		t.it("copes with a zero-length night", function()
			t.expect(F.burnFuel(5, 1, 0, 1)).toBe(4)
		end)
	end)

	t.describe("nightsLeft", function()
		t.it("goes further with a tune-up", function()
			t.expect(F.nightsLeft(1.5, 1)).toBe(1.5)
			t.expect(F.nightsLeft(1.5, 0.5)).toBe(3)
		end)
	end)

	t.describe("canPour", function()
		t.it("only when the whole can fits", function()
			t.expect(F.canPour(2, 1, 3)).toBe(true)
			t.expect(F.canPour(2.1, 1, 3)).toBe(false)
			t.expect(F.canPour(0, 1, 3)).toBe(true)
		end)
		t.it("rounding errors don't refuse a can", function()
			t.expect(F.canPour(2 + 1e-9, 1, 3)).toBe(true)
		end)
	end)

	t.describe("justRanLow", function()
		t.it("once, on the way past", function()
			t.expect(F.justRanLow(0.26, 0.25, 0.25)).toBe(true)
			t.expect(F.justRanLow(0.25, 0.24, 0.25)).toBe(false)
			t.expect(F.justRanLow(0.5, 0.26, 0.25)).toBe(false)
		end)
		t.it("not when it ran out altogether", function()
			t.expect(F.justRanLow(0.3, 0, 0.25)).toBe(false)
		end)
	end)

	t.describe("fuelText", function()
		t.it("reads naturally", function()
			t.expect(F.fuelText(0)).toBe("empty")
			t.expect(F.fuelText(1)).toBe("1 night of fuel")
			t.expect(F.fuelText(0.98)).toBe("1 night of fuel")
			t.expect(F.fuelText(1.52)).toBe("1.5 nights of fuel")
			t.expect(F.fuelText(3)).toBe("3 nights of fuel")
		end)
		t.it("never says 0 while there's some left", function()
			t.expect(F.fuelText(0.01)).toBe("0.1 nights of fuel")
		end)
	end)
end
