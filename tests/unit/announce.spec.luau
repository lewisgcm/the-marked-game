-- How phase changes are announced (src/shared/announce.ts).
return function(t)
	local A = require("../../out/shared/announce")
	local function at(phase, night)
		return A.announcementFor({ phase = phase, night = night })
	end

	t.describe("announcementFor", function()
		t.it("Day 1 has the title card, so nothing else", function()
			local a = at("Day", 1)
			t.expect(a.banner or a.advice or a.pulse or a.chime).toBe(false)
		end)
		t.it("days and nights get the banner", function()
			t.expect(at("Day", 2).banner).toBe(true)
			t.expect(at("Night", 1).banner).toBe(true)
			t.expect(at("Night", 9).banner).toBe(true)
			t.expect(at("Night", 9).pulse).toBe(false)
		end)
		t.it("advice only to begin with", function()
			t.expect(at("Night", 1).advice).toBe(true)
			t.expect(at("Night", 2).advice).toBe(true)
			t.expect(at("Day", 2).advice).toBe(true)
			t.expect(at("Day", 3).advice).toBe(false)
			t.expect(at("Night", 3).advice).toBe(false)
		end)
		t.it("dusk only makes the clock pulse", function()
			local a = at("Dusk", 1)
			t.expect(a.banner).toBe(false)
			t.expect(a.advice).toBe(false)
			t.expect(a.pulse).toBe(true)
		end)
		t.it("dawn leaves it to the dawn card", function()
			local a = at("Dawn", 1)
			t.expect(a.banner).toBe(false)
			t.expect(a.advice).toBe(false)
			t.expect(a.pulse).toBe(false)
		end)
		t.it("every change but Day 1 chimes", function()
			for _, phase in { "Day", "Dusk", "Night", "Dawn" } do
				t.expect(at(phase, 2).chime).toBe(true)
			end
			t.expect(at("Dusk", 1).chime).toBe(true)
		end)
	end)
end
