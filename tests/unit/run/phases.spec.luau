-- The day/night clock (src/shared/run/phases.ts).
return function(t)
	local phases = require("../../../out/shared/run/phases")

	local function clock(night, phase)
		return { night = night, phase = phase }
	end

	t.describe("nextClock", function()
		t.it("a run starts on Day 1", function()
			local c = phases.firstClock()
			t.expect(c.night).toBe(1)
			t.expect(c.phase).toBe("Day")
		end)
		t.it("goes Day, Dusk, Night, Dawn within the same night", function()
			local c = phases.firstClock()
			c = phases.nextClock(c)
			t.expect(c.phase).toBe("Dusk")
			c = phases.nextClock(c)
			t.expect(c.phase).toBe("Night")
			c = phases.nextClock(c)
			t.expect(c.phase).toBe("Dawn")
			t.expect(c.night).toBe(1)
		end)
		t.it("Dawn rolls over to the next day", function()
			local c = phases.nextClock(clock(1, "Dawn"))
			t.expect(c.phase).toBe("Day")
			t.expect(c.night).toBe(2)
		end)
	end)

	t.describe("nightsSurvived", function()
		t.it("none until the first dawn", function()
			t.expect(phases.nightsSurvived(clock(1, "Day"))).toBe(0)
			t.expect(phases.nightsSurvived(clock(1, "Night"))).toBe(0)
		end)
		t.it("a night counts once its dawn arrives", function()
			t.expect(phases.nightsSurvived(clock(1, "Dawn"))).toBe(1)
			t.expect(phases.nightsSurvived(clock(2, "Day"))).toBe(1)
			t.expect(phases.nightsSurvived(clock(3, "Night"))).toBe(2)
		end)
	end)

	t.describe("phaseLength and phaseTitle", function()
		t.it("looks up the phase's length", function()
			local lengths = { Day = 180, Dusk = 45, Night = 150, Dawn = 45 }
			t.expect(phases.phaseLength(clock(4, "Night"), lengths)).toBe(150)
			t.expect(phases.phaseLength(clock(4, "Dusk"), lengths)).toBe(45)
		end)
		t.it("numbers days and nights only", function()
			t.expect(phases.phaseTitle(clock(2, "Day"))).toBe("DAY 2")
			t.expect(phases.phaseTitle(clock(2, "Night"))).toBe("NIGHT 2")
			t.expect(phases.phaseTitle(clock(2, "Dusk"))).toBe("DUSK")
			t.expect(phases.phaseTitle(clock(2, "Dawn"))).toBe("DAWN")
		end)
	end)
end
