-- The flashlight's reveal cone geometry (src/shared/flashlight.ts). Walls are a raycast in the
-- engine and aren't covered here.
return function(t)
	local flashlight = require("../../out/shared/flashlight")
	local V = require("@lune/roblox").Vector3
	local origin = V.new(0, 0, 0)
	local aim = V.new(0, 0, -1)
	local cos30 = math.cos(math.rad(30))
	local function at(degrees, distance)
		local r = math.rad(degrees)
		return V.new(math.sin(r) * distance, 0, -math.cos(r) * distance)
	end
	local function lit(point)
		return flashlight.inBeamCone(origin, aim, point, 60, cos30)
	end

	t.describe("inBeamCone (60 studs, 30 degree half-angle)", function()
		t.it("straight ahead is lit", function()
			t.expect(lit(at(0, 10))).toBe(true)
		end)
		t.it("at the edge of range is lit", function()
			t.expect(lit(at(0, 60))).toBe(true)
		end)
		t.it("beyond range isn't", function()
			t.expect(lit(at(0, 60.5))).toBe(false)
		end)
		t.it("just inside the cone is lit", function()
			t.expect(lit(at(29, 20))).toBe(true)
		end)
		t.it("just outside the cone isn't", function()
			t.expect(lit(at(31, 20))).toBe(false)
		end)
		t.it("behind the hunter isn't", function()
			t.expect(lit(at(180, 5))).toBe(false)
		end)
		t.it("above the beam isn't", function()
			t.expect(lit(V.new(0, 20, -10))).toBe(false)
		end)
		t.it("the hunter's own position isn't", function()
			t.expect(lit(origin)).toBe(false)
		end)
		t.it("uses the cone's matching constants", function()
			t.expect(flashlight.FLASHLIGHT_RANGE).toBe(60)
			t.expect(flashlight.FLASHLIGHT_HALF_ANGLE).toBe(30)
		end)
	end)
end
