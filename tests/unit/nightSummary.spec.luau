-- The dawn summary (src/shared/nightSummary.ts).
return function(t)
	local ns = require("../../out/shared/nightSummary")

	t.describe("summarise", function()
		t.it("lists what the night cost", function()
			local s = ns.summarise(3, { planksLost = 4, infectedDowned = 7, taken = { "Sam", "Alex" } })
			t.expect(s.title).toBe("NIGHT 3 SURVIVED")
			t.expect(s.lines[1]).toBe("Infected downed: 7")
			t.expect(s.lines[2]).toBe("Planks lost: 4")
			t.expect(s.lines[3]).toBe("Taken: Sam, Alex")
		end)
		t.it("names a single taken kid", function()
			local s = ns.summarise(1, { planksLost = 0, infectedDowned = 0, taken = { "Sam" } })
			t.expect(s.lines[3]).toBe("Taken: Sam")
		end)
		t.it("says so when nobody was taken", function()
			t.expect(ns.summarise(1, ns.emptyTally()).lines[3]).toBe("Nobody was taken")
		end)
	end)

	t.describe("addTaken", function()
		t.it("lists a kid taken twice once", function()
			local tally = ns.emptyTally()
			ns.addTaken(tally, "Sam")
			ns.addTaken(tally, "Sam")
			t.expect(#tally.taken).toBe(1)
		end)
	end)
end
