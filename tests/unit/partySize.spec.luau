-- Validation of the party size a lobby host sends (src/lobby/server/partySize.ts). The value
-- comes from the client, so junk must always produce a safe size.
return function(t)
	local parsePartySize = require("../../out/lobby/server/partySize").parsePartySize
	local function parse(value)
		return parsePartySize(value, 2, 6)
	end

	t.describe("parsePartySize (2..6)", function()
		t.it("keeps a valid size", function()
			t.expect(parse(4)).toBe(4)
		end)
		t.it("clamps too small up to the minimum", function()
			t.expect(parse(1)).toBe(2)
		end)
		t.it("clamps too big down to the maximum", function()
			t.expect(parse(99)).toBe(6)
		end)
		t.it("rounds fractions down", function()
			t.expect(parse(3.7)).toBe(3)
		end)
		t.it("falls back to the minimum for nil", function()
			t.expect(parse(nil)).toBe(2)
		end)
		t.it("rejects numeric strings", function()
			t.expect(parse("6")).toBe(2)
		end)
		t.it("rejects tables", function()
			t.expect(parse({ 6 })).toBe(2)
		end)
		t.it("rejects NaN", function()
			t.expect(parse(0 / 0)).toBe(2)
		end)
		t.it("clamps infinity", function()
			t.expect(parse(math.huge)).toBe(6)
			t.expect(parse(-math.huge)).toBe(2)
		end)
	end)
end
