-- Spook charge recharge and scare rewards (src/shared/spooks.ts).
return function(t)
	local spooks = require("../../out/shared/spooks")
	local MAX, RECHARGE = 3, 40
	local function advance(charges, nextChargeAt, now, bonus)
		return spooks.advanceCharges({ charges = charges, nextChargeAt = nextChargeAt }, now, bonus, MAX, RECHARGE)
	end

	t.describe("advanceCharges", function()
		t.it("does nothing before the charge is due", function()
			local s = advance(1, 40, 39, 0)
			t.expect(s.charges).toBe(1)
			t.expect(s.nextChargeAt).toBe(40)
		end)
		t.it("grants a charge when due and starts the next wait", function()
			local s = advance(1, 40, 40, 0)
			t.expect(s.charges).toBe(2)
			t.expect(s.nextChargeAt).toBe(80)
		end)
		t.it("a scare pulls the next charge closer", function()
			local s = advance(1, 40, 10, 8)
			t.expect(s.charges).toBe(1)
			t.expect(s.nextChargeAt).toBe(32)
		end)
		t.it("a big scare grants the charge and carries the rest over", function()
			-- 30s left, 35s bonus: charge now, and the next one is 5s ahead of schedule.
			local s = advance(1, 40, 10, 35)
			t.expect(s.charges).toBe(2)
			t.expect(s.nextChargeAt).toBe(45)
		end)
		t.it("never goes past the max", function()
			local s = advance(2, 40, 10, 500)
			t.expect(s.charges).toBe(3)
		end)
		t.it("bonuses are wasted at max", function()
			local s = advance(3, 40, 10, 20)
			t.expect(s.charges).toBe(3)
			t.expect(s.nextChargeAt).toBe(40)
		end)
		t.it("ignores negative bonuses", function()
			local s = advance(1, 40, 10, -20)
			t.expect(s.nextChargeAt).toBe(40)
		end)
	end)
end
