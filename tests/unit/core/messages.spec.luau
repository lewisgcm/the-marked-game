-- The message bar (src/shared/core/messages.ts).
return function(t)
	local M = require("../../../out/shared/core/messages")

	local function message(kind, text, at)
		return { kind = kind, text = text, at = at or 0 }
	end
	-- A bar that's been sent these messages, then stepped once at time 0.
	local function bar(...)
		local b = M.emptyBar()
		for _, m in { ... } do
			M.pushMessage(b, m)
		end
		M.stepBar(b, 0, 0.1)
		return b
	end
	local function text(b)
		return b.showing and b.showing.text
	end

	t.describe("one at a time", function()
		t.it("nothing to say, nothing showing", function()
			t.expect(text(bar())).toBe(nil)
		end)
		t.it("danger first, then the walkie, then news", function()
			local b = bar(message("Info", "i"), message("Walkie", "w"), message("Danger", "d"))
			t.expect(text(b)).toBe("d")
			M.stepBar(b, 4, 0.1)
			t.expect(text(b)).toBe("w")
			M.stepBar(b, 10, 0.1)
			t.expect(text(b)).toBe("i")
			M.stepBar(b, 13, 0.1)
			t.expect(text(b)).toBe(nil)
		end)
		t.it("the same kind goes in order", function()
			local b = bar(message("Danger", "first"), message("Danger", "second"))
			t.expect(text(b)).toBe("first")
			M.stepBar(b, 4, 0.1)
			t.expect(text(b)).toBe("second")
		end)
		t.it("each stays for its full time", function()
			local b = bar(message("Walkie", "w"), message("Walkie", "x"))
			M.stepBar(b, 5.9, 0.1)
			t.expect(text(b)).toBe("w")
			M.stepBar(b, 6, 0.1)
			t.expect(text(b)).toBe("x")
			M.stepBar(b, 11.9, 0.1)
			t.expect(text(b)).toBe("x")
		end)
	end)

	t.describe("danger", function()
		t.it("takes over, and a cut-off walkie message gets another turn", function()
			local b = bar(message("Walkie", "w"))
			M.pushMessage(b, message("Danger", "d", 1))
			M.stepBar(b, 1, 0.1)
			t.expect(text(b)).toBe("d")
			M.stepBar(b, 5, 0.1)
			t.expect(text(b)).toBe("w")
		end)
		t.it("cut-off news doesn't come back", function()
			local b = bar(message("Info", "i"))
			M.pushMessage(b, message("Danger", "d", 1))
			M.stepBar(b, 1, 0.1)
			t.expect(text(b)).toBe("d")
			M.stepBar(b, 5, 0.1)
			t.expect(text(b)).toBe(nil)
		end)
		t.it("doesn't cut off danger", function()
			local b = bar(message("Danger", "d"))
			M.pushMessage(b, message("Danger", "e", 1))
			M.stepBar(b, 1, 0.1)
			t.expect(text(b)).toBe("d")
		end)
		t.it("other messages don't cut anything off", function()
			local b = bar(message("Info", "i"))
			M.pushMessage(b, message("Walkie", "w", 1))
			M.stepBar(b, 1, 0.1)
			t.expect(text(b)).toBe("i")
		end)
	end)

	t.describe("old news", function()
		-- Danger shows until 4; then whatever `m` is waits until `now`.
		local function waitsUntil(m, now)
			local b = bar(message("Danger", "d"), m)
			b.since = now - 3.9
			M.stepBar(b, now, 0.1)
			M.stepBar(b, now + 0.1, 0.1)
			return text(b)
		end
		t.it("news waits 10 seconds at most", function()
			t.expect(waitsUntil(message("Info", "i"), 9.9)).toBe("i")
			t.expect(waitsUntil(message("Info", "i"), 10)).toBe(nil)
		end)
		t.it("the walkie waits 30", function()
			t.expect(waitsUntil(message("Walkie", "w"), 29.9)).toBe("w")
			t.expect(waitsUntil(message("Walkie", "w"), 30)).toBe(nil)
		end)
		t.it("danger is never dropped", function()
			t.expect(waitsUntil(message("Danger", "e"), 500)).toBe("e")
		end)
	end)

	t.describe("repeats", function()
		t.it("ignored while the same thing is showing or waiting", function()
			local b = bar(message("Info", "a"), message("Info", "b"))
			M.pushMessage(b, message("Info", "a"))
			M.pushMessage(b, message("Info", "b"))
			t.expect(#b.queue).toBe(1)
		end)
		t.it("ignored just after it went, then allowed again", function()
			local b = bar(message("Danger", "d"))
			M.stepBar(b, 4, 0.1)
			M.pushMessage(b, message("Danger", "d", 8.9))
			t.expect(#b.queue).toBe(0)
			M.pushMessage(b, message("Danger", "d", 9))
			t.expect(#b.queue).toBe(1)
		end)
	end)

	t.describe("something else", function()
		t.it("shows straight after a message goes", function()
			local b = bar(message("Danger", "d"))
			M.stepBar(b, 4, 0.1)
			M.pushMessage(b, message("Danger", "e", 4))
			M.stepBar(b, 4.1, 0.1)
			t.expect(text(b)).toBe("e")
		end)
	end)

	t.describe("tips", function()
		t.it("seen for a while, then gone", function()
			local b = bar()
			M.setTip(b, "tip")
			t.expect(M.visibleTip(b)).toBe("tip")
			M.stepBar(b, 1, 7.9)
			t.expect(M.visibleTip(b)).toBe("tip")
			M.stepBar(b, 2, 0.2)
			t.expect(M.visibleTip(b)).toBe(nil)
		end)
		t.it("give way to messages without losing time", function()
			local b = bar()
			M.setTip(b, "tip")
			M.pushMessage(b, message("Info", "i"))
			M.stepBar(b, 0, 5)
			t.expect(M.visibleTip(b)).toBe(nil)
			M.stepBar(b, 3, 0.1)
			t.expect(M.visibleTip(b)).toBe("tip")
			M.stepBar(b, 4, 7)
			t.expect(M.visibleTip(b)).toBe("tip")
		end)
		t.it("only a changed tip gets more time", function()
			local b = bar()
			M.setTip(b, "tip")
			M.stepBar(b, 1, 8)
			M.setTip(b, "tip")
			t.expect(M.visibleTip(b)).toBe(nil)
			M.setTip(b, "new")
			t.expect(M.visibleTip(b)).toBe("new")
		end)
		t.it("no tip, nothing seen", function()
			local b = bar()
			M.setTip(b, "tip")
			M.setTip(b, "")
			t.expect(M.visibleTip(b)).toBe(nil)
		end)
	end)
end
